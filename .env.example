# If using Render managed Postgres, set DATABASE_URL instead of DB_HOST/DB_USER/DB_PASSWORD
# DATABASE_URL=postgres://user:password@host:port/kabianga_lost_and_found
DB_PROTOCOL=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=kabianga_lost_and_found
SESSION_SECRET=change_this_secret
PORT=3000

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_smtp_username
EMAIL_PASS=your_smtp_password
EMAIL_FROM="Kabianga Lost & Found <no-reply@kabianga.ac.ke>"
